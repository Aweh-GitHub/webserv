#! Config d'evaluation : chaque bloc correspond a un point de la fiche.
#! Lancer depuis la racine du repo : ./webserv eval/eval.config

#! Site A : 127.0.0.1:8080 (fiche : plusieurs sites, pages d'erreur, routes...)
server:{
	hostIp:"127.0.0.1"
	listenPort:8080
	serverDomains:"127.0.0.1","localhost"
	pathRoot:"./eval/site_a"
	indexFiles:"index.html"
	clientMaxBodySize:10485760
	errorPage:404,"/errors/404.html"
	errorPage:405,"/errors/405.html"
	errorPage:413,"/errors/413.html"
	errorPage:500,502,503,504,"/errors/50x.html"
	#! Racine : GET, POST, DELETE
	location:{
		name:"/"
		pathRoot:"./eval/site_a"
		indexFiles:"index.html"
		allowedMethods:"GET","POST","DELETE"
		autoIndex:"false"
	}
	#! Route vers un autre dossier : le site statique complet
	location:{
		name:"/static"
		pathRoot:"./www/site0/root"
		indexFiles:"index.html"
		allowedMethods:"GET"
	}
	#! Fichier par defaut d'un dossier
	location:{
		name:"/dir_index"
		pathRoot:"./eval/site_a/dir_index"
		indexFiles:"default.html"
		allowedMethods:"GET"
	}
	#! Listing de dossier
	location:{
		name:"/listing"
		pathRoot:"./www/site0"
		allowedMethods:"GET"
		autoIndex:"true"
	}
	#! Petite limite de body (20 octets)
	location:{
		name:"/upload"
		pathRoot:"./eval/uploads"
		allowedMethods:"GET","POST","DELETE"
		autoIndex:"true"
		pathUploadStore:"./eval/uploads"
		clientMaxBodySize:20
	}
	#! Upload normal (limite du serveur : 10 Mo)
	location:{
		name:"/up"
		pathRoot:"./eval/uploads"
		allowedMethods:"GET","POST","DELETE"
		autoIndex:"true"
		pathUploadStore:"./eval/uploads"
	}
	#! GET seulement : DELETE interdit
	location:{
		name:"/nodelete"
		pathRoot:"./eval/uploads"
		allowedMethods:"GET"
	}
	#! Redirection
	location:{
		name:"/redir"
		redirect:301,"/static/"
	}
	#! CGI Python
	location:{
		name:"/cgi"
		pathRoot:"./eval/cgi"
		allowedMethods:"GET","POST"
		cgiExtension:".py","/usr/bin/python3"
	}
}

#! Site B : autre interface, meme port
server:{
	hostIp:"127.0.0.2"
	listenPort:8080
	serverDomains:"127.0.0.2"
	pathRoot:"./eval/site_b"
	indexFiles:"index.html"
	location:{
		name:"/"
		allowedMethods:"GET"
	}
}

#! Site C : meme interface, autre port
server:{
	hostIp:"127.0.0.1"
	listenPort:8081
	serverDomains:"127.0.0.1","localhost"
	pathRoot:"./eval/site_c"
	indexFiles:"index.html"
	location:{
		name:"/"
		allowedMethods:"GET"
	}
}
