server:{
	hostIp:"127.0.0.1"
	listenPort:8080
	serverDomains:"localhost","www.monsite.local"
	pathRoot:"./www/site1"
	indexFiles:"index.html","index.htm"
	clientMaxBodySize:10485760
	errorPage:404,"/errors/404.html"
	errorPage:500,502,503,"/errors/50x.html"
	location:{
			name:"/"
			pathRoot:"./www/site0/root"
			indexFiles:"index.html","index.htm"
			allowedMethods:"GET","POST"
			autoIndex:"false"
			pathUploadStore:"./www/uploads"
			cgiExtension:".py","/usr/bin/python3"
	}
//	location:{
//		name:"/images"
//		pathRoot:"./www/site1/public"
//		allowedMethods:"GET"
//		autoIndex:"true"
//	}
}
server:{
	hostIp:"127.0.0.67"
	listenPort:9696
	serverDomains:"bob","www.myalt.swag"
	pathRoot:"./www/siteswagger"
	indexFiles:"index.html","index.htm"
	clientMaxBodySize:10485760
	errorPage:404,"/errors/404.html"
	errorPage:500,502,503,"/errors/50x.html"
	location:{
			name:"/"
			pathRoot:"./www/site0/root"
			indexFiles:"index.html","index.htm"
			allowedMethods:"GET","POST"
			autoIndex:"false"
			pathUploadStore:"./www/uploads"
			cgiExtension:".sh","/usr/bin/bash"
	}
}