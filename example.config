server: {
    hostIp: "127.0.0.1"
    listenPort: 8080
    serverDomains: "localhost", "127.0.0.1"
    pathRoot: "./www/site0/root"
    indexFiles: "index.html"
    clientMaxBodySize: 10485760
    location: {
        name: "/"
        pathRoot: "./www/site0/root"
        allowedMethods: "GET", "POST", "DELETE"
        autoIndex: "false"
    }
    location:{
        name:"/r"
        redirect:301, "/redir"
    }
	location:{
		name:"/redir"
		redirect:301, "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
	}
	location:{
		name:"/timeout"
		pathRoot:"./www/site0/timeout"
		indexFiles:"timeout.php"
		allowedMethods:"GET"
		autoIndex:"false"
		cgiExtension:".php","/usr/bin/php-cgi"
	}
}