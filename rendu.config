#!															!#
#!							SERV 1							!#
#!															!#
#!															!#
server: {
    hostIp:"0.0.0.0"
    listenPort:8080
    serverDomains:"localhost"
    pathRoot:"./www/site1/root"
    indexFiles:"index.html"
    clientMaxBodySize: 10485760

    errorPage:404,"/errors/404.html"
    errorPage:500,502,503,"/errors/50x.html"

    location:{
        name:"/"
        pathRoot:"./www/site1/root"
        allowedMethods:"GET"
        indexFiles:"index.html"
        autoIndex:"false"
    }

    location:{
        name:"/uploads"
        pathRoot:"./www/uploads"
        allowedMethods:"GET","POST","DELETE"
        pathUploadStore:"./www/uploads"
        autoIndex:"true"
    }

    location:{
        name:"/testpy"
        pathRoot:"./www/site1/testpy"
        allowedMethods:"GET","POST"
        autoIndex:"false"
        cgiExtension:".py","/usr/bin/python3"
    }

    location:{
        name:"/redir"
        redirect:301,"https://youtu.be/dQw4w9WgXcQ?si=w99y1YuEbXfLOcQM"
    }

    location:{
        name:"/onlyget"
        pathRoot:"./www/site1/onlyget"
        allowedMethods:"GET"
        autoIndex:"false"
    }
    location:{
        name:"/onlypost"
        pathRoot:"./www/site1/onlypost"
        allowedMethods:"POST"
        autoIndex:"false"
    }
	location:{
        name:"/onlydelete"
        pathRoot:"./www/site1/onlydelete"
        allowedMethods:"DELETE"
        autoIndex:"false"
    }
    location:{
			name:"/wordpress"
			pathRoot:"./www/site1/wordpress"
			indexFiles:"index.php"
			allowedMethods:"GET","POST","DELETE"
			autoIndex:"false"
			cgiExtension:".php","/usr/bin/php-cgi"
             }
}
#!															!#
#!							SERV 2							!#
#!															!#
#!															!#
server: {
    hostIp:"0.0.0.0"
    listenPort:8080
    serverDomains:"localhost4"
    pathRoot:"./www/site2/root"
    clientMaxBodySize:5242880

    errorPage:404,"/errors/404.html"

    location:{
        name:"/"
        pathRoot:"./www/site2/root"
        allowedMethods:"GET"
        autoIndex:"true"
    }
}